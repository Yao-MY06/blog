---
import { getCollection } from "astro:content";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getPostUrlBySlug } from "../utils/url-utils";

// 分组定义：新增 status 值时需同步 match 列表，否则该项目不会显示
const groups = [
	{ label: "进行中", match: ["进行中", "开发中"] },
	{ label: "规划中", match: ["规划中"] },
	{ label: "已完成", match: ["已完成", "已上线"] },
];

const projects = (
	await getCollection("projects", ({ data }) =>
		import.meta.env.PROD ? data.published !== false : true,
	)
)
	.map((e) => e.data)
	.sort((a, b) => a.order - b.order);

const unmatched = projects.filter(
	(p) => !groups.some((g) => g.match.includes(p.status)),
);
if (unmatched.length > 0) {
	console.warn(
		`[projects] status 未命中分组、不会显示：${unmatched.map((p) => p.name).join("、")}`,
	);
}

const allPosts = (
	await getCollection("posts", ({ data }) =>
		import.meta.env.PROD ? data.draft !== true : true,
	)
).sort(
	(a, b) =>
		new Date(b.data.published).getTime() - new Date(a.data.published).getTime(),
);
const relatedOf = (tags: string[]) =>
	tags.length === 0
		? []
		: allPosts.filter((p) => p.data.tags.some((t) => tags.includes(t))).slice(0, 3);
---
<MainGridLayout title="项目" description="我在做什么，做得怎么样">
    {groups.map((g) => {
        const list = projects.filter((p) => g.match.includes(p.status));
        return list.length > 0 && (
            <section class="mb-2">
                <h2 class="font-bold text-xl text-90 mb-3 ml-1">{g.label}
                    <span class="text-sm text-50 font-normal ml-2">{list.length}</span>
                </h2>
                <div class="flex flex-col gap-4 mb-6">
                    {list.map((p) => {
                        const related = relatedOf(p.tags);
                        return (
                        <div class="card-base p-6 md:px-9 md:py-7 transition hover:drop-shadow-[0_4px_12px_rgba(0,0,0,0.08)]">
                            <div class="flex items-center gap-3 flex-wrap">
                                {p.url ? (
                                    <a href={p.url} target="_blank" rel="noopener"
                                       class="transition inline-flex items-center gap-2 font-bold text-2xl text-90 hover:text-[var(--primary)]">
                                        {p.name}
                                    </a>
                                ) : (
                                    <span class="font-bold text-2xl text-90">{p.name}</span>
                                )}
                                <span class="text-sm px-2 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">{p.status}</span>
                                {p.repo && (
                                    <a href={p.repo} target="_blank" rel="noopener"
                                       class="ml-auto text-sm text-50 transition hover:text-[var(--primary)]">源码 →</a>
                                )}
                            </div>
                            <p class="text-75 mt-3">{p.description}</p>
                            <div class="flex gap-2 mt-4 flex-wrap">
                                {p.tags.map((t) => (
                                    <span class="text-sm px-2 py-0.5 rounded-md bg-[var(--btn-regular-bg)] text-[var(--btn-content)]">{t}</span>
                                ))}
                            </div>
                            {related.length > 0 && (
                                <div class="mt-4 pt-3 border-t border-dashed border-[var(--line-divider)] flex items-baseline gap-2 flex-wrap">
                                    <span class="text-sm text-50 shrink-0">相关文章</span>
                                    {related.map((r) => (
                                        <a href={getPostUrlBySlug(r.slug)}
                                           class="text-sm text-75 transition hover:text-[var(--primary)]">{r.data.title}</a>
                                    ))}
                                </div>
                            )}
                        </div>
                        );
                    })}
                </div>
            </section>
        );
    })}
</MainGridLayout>
