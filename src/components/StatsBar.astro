---
import { getCollection } from "astro:content";
import { getCategoryList, getTagList } from "../utils/content-utils";

const posts = await getCollection("posts", ({ data }) =>
	import.meta.env.PROD ? data.draft !== true : true,
);
const categories = await getCategoryList();
const tags = await getTagList();
const latest = posts
	.map((p) => new Date(p.data.published))
	.sort((a, b) => +b - +a)[0];

const words = posts.reduce((sum, p) => {
	const text = (p.body ?? "").replace(/```[\s\S]*?```/g, " ");
	const cjk = (text.match(/[\u4e00-\u9fff]/g) ?? []).length;
	const latin = (text.match(/[a-zA-Z0-9]+/g) ?? []).length;
	return sum + cjk + latin;
}, 0);
const wan = (words / 10000).toFixed(1);

const items = [
	{ label: "文章", value: `${posts.length} 篇` },
	{ label: "分类", value: `${categories.length} 个` },
	{ label: "标签", value: `${tags.length} 个` },
	{ label: "累计输出", value: `${wan} 万字` },
	{ label: "最近更新", value: latest.toISOString().slice(0, 10) },
];
---
<div class="card-base px-6 md:px-9 py-4 mb-4 onload-animation flex flex-wrap gap-x-8 gap-y-2">
    {items.map((it) => (
        <div class="flex items-baseline gap-2">
            <span class="font-bold text-lg text-[var(--primary)]">{it.value}</span>
            <span class="text-sm text-50">{it.label}</span>
        </div>
    ))}
</div>
